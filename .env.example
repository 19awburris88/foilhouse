# Square API credentials
# Get these from https://developer.squareup.com → Applications → your app

# Production access token (Credentials tab → Production)
SQUARE_ACCESS_TOKEN=

# Location ID (from Square Dashboard → Account & Settings → Business locations)
SQUARE_LOCATION_ID=

# Set to "sandbox" during testing, "production" when live
# (The functions use the URL to distinguish — this is just for reference)
SQUARE_ENVIRONMENT=production

# Set to true to use real Square checkout instead of the demo flow
VITE_SQUARE_LIVE=false
